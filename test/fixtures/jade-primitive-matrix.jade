vars
    anyValue : Any;
    binaryValue : Binary[4];
    booleanValue : Boolean;
    byteValue : Byte;
    characterValue : Character;
    dateValue : Date;
    decimalValue : Decimal[12,2];
    integerValue : Integer;
    integer64Value : Integer64;
    addressValue : MemoryAddress;
    pointValue : Point;
    realValue : Real;
    stringValue : String[20];
    utf8Value : StringUtf8[20];
    timeValue : Time;
    stampValue : TimeStamp;
    intervalValue : TimeStampInterval;
    offsetValue : TimeStampOffset;
begin
    anyValue := 42;
    binaryValue := #[41 42];
    booleanValue := true;
    byteValue := (7).Byte;
    characterValue := "J";
    dateValue.setDate(7,11,2026);
    decimalValue := 12.50;
    integerValue := 3;
    integer64Value := 2147483648;
    addressValue := null;
    pointValue.set(3,4);
    realValue := 1.5;
    stringValue := "hello";
    utf8Value := @"Jade";
    timeValue.setTime(13,14,15,0);
    stampValue.setDate(dateValue);
    stampValue.setTime(timeValue);
    intervalValue := stampValue - stampValue;
    offsetValue.setFromLocalTimeStamp(stampValue,0);
    write "Any=" & anyValue.Integer.String;
    write "BinaryLength=" & binaryValue.length.String;
    write "Boolean=" & booleanValue.String;
    write "Byte=" & byteValue.String;
    write "Character=" & characterValue.String;
    write "Date=" & dateValue.String;
    write "Decimal=" & decimalValue.String;
    write "Integer=" & integerValue.String;
    write "Integer64=" & integer64Value.String;
    write "MemoryAddressNull=" & (addressValue = null).String;
    write "Point=" & pointValue.String;
    write "Real=" & realValue.String;
    write "String=" & stringValue;
    write "StringUtf8=" & utf8Value.String;
    write "Time=" & timeValue.String;
    write "TimeStamp=" & stampValue.String;
    write "TimeStampInterval=" & intervalValue.String;
    write "TimeStampOffset=" & offsetValue.String;
end;
