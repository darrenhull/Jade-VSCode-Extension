{
  "name": "Jade JOX",
  "scopeName": "text.xml.jade-jox",
  "patterns": [
    {
      "include": "#method"
    },
    {
      "include": "text.xml"
    }
  ],
  "repository": {
    "method": {
      "name": "meta.method.jox",
      "begin": "<JadeMethod(?=\\s|/?>)",
      "end": "</JadeMethod(?=\\s|>)|/\\s*>",
      "beginCaptures": {
        "0": {
          "name": "entity.name.tag.xml"
        }
      },
      "endCaptures": {
        "0": {
          "name": "entity.name.tag.xml"
        }
      },
      "patterns": [
        {
          "begin": ">",
          "end": "(?=</JadeMethod(?=\\s|>))",
          "beginCaptures": {
            "0": {
              "name": "entity.name.tag.xml"
            }
          },
          "patterns": [
            {
              "include": "#source"
            },
            {
              "include": "text.xml"
            }
          ]
        },
        {
          "include": "#method-opening"
        }
      ]
    },
    "source": {
      "name": "meta.method.source.jox",
      "begin": "<source(?=\\s|/?>)",
      "end": "</source(?=\\s|>)|/\\s*>",
      "beginCaptures": {
        "0": {
          "name": "entity.name.tag.xml"
        }
      },
      "endCaptures": {
        "0": {
          "name": "entity.name.tag.xml"
        }
      },
      "patterns": [
        {
          "begin": ">",
          "end": "(?=</source(?=\\s|>))",
          "beginCaptures": {
            "0": {
              "name": "entity.name.tag.xml"
            }
          },
          "contentName": "source.jade-nz",
          "patterns": [
            {
              "begin": "<!\\[CDATA\\[",
              "end": "\\]\\]>",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.string.begin.xml"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.string.end.xml"
                }
              },
              "patterns": [
                {
                  "include": "source.jade-nz"
                }
              ]
            },
            {
              "name": "constant.character.entity.xml",
              "match": "&(?:#[xX][0-9A-Fa-f]+|#\\d+|[A-Za-z_:][\\w:.-]*);"
            },
            {
              "include": "source.jade-nz"
            }
          ]
        },
        {
          "include": "#source-opening"
        }
      ]
    },
    "method-opening": {
      "name": "meta.tag.jox",
      "begin": "(?<=<JadeMethod)\\G",
      "end": "(?=>|/\\s*>)",
      "endCaptures": {
        "0": {
          "name": "entity.name.tag.xml"
        }
      },
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    },
    "source-opening": {
      "name": "meta.tag.jox",
      "begin": "(?<=<source)\\G",
      "end": "(?=>|/\\s*>)",
      "patterns": [
        {
          "include": "#attributes"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "string.quoted.double.xml",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single.xml",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "entity.other.attribute-name.xml",
          "match": "[A-Za-z_:][\\w:.-]*(?=\\s*=)"
        },
        {
          "name": "punctuation.separator.key-value.xml",
          "match": "="
        }
      ]
    }
  }
}
